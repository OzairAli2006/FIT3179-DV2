{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",

  "title": {
    "text": "How have Year 12 subject choices changed over time?",
    "subtitle": "Participation by learning area between 2010 - 2024",
    "anchor": "start",
    "fontSize": 18,
    "subtitleFontSize": 13
  },

  "data": {
    "url": "data/acara_learning_area_trends.csv",
    "format": {
      "type": "csv",
      "parse": {"Year": "number", "Participation": "number"}
    }
  },

  "params": [
    {
      "name": "area_highlight",
      "select": {"type": "point", "fields": ["LearningArea"]},
      "bind": "legend"
    }
  ],

  "width": 400,
  "height": 290,

  "mark": {
    "type": "line",
    "point": true,
    "strokeWidth": 2
  },

  "encoding": {
    "x": {
      "field": "Year",
      "type": "quantitative",
      "title": "Year",
      "scale": {"domain": [2010, 2024]},
      "axis": {
        "format": "d",
        "tickCount": 8,
        "grid": false,
        "labelFontSize": 11,
        "titleFontSize": 12
      }
    },

    "y": {
      "field": "Participation",
      "type": "quantitative",
      "title": "Year 12 participation (%)",
      "scale": {"domain": [0, 90]},
      "axis": {
        "grid": true,
        "gridColor": "#E6E6E6",
        "tickCount": 6,
        "labelFontSize": 11,
        "titleFontSize": 12
      }
    },

    "color": {
      "field": "LearningArea",
      "type": "nominal",
      "title": "Learning area",
      "scale": {
        "domain": [
          "English",
          "Mathematics",
          "Society and Environment",
          "Science",
          "Technology",
          "Health and Physical Education",
          "Arts",
          "Languages other than English"
        ],
        "range": [
          "#0072B2",
          "#D55E00",
          "#009E73",
          "#CC79A7",
          "#E69F00",
          "#6F4E7C",
          "#333333",
          "#527A86"
        ]
      },
      "legend": {
        "orient": "bottom",
        "columns": 2,
        "labelFontSize": 10,
        "titleFontSize": 11,
        "labelLimit": 200
      }
    },

    "opacity": {
      "condition": {"param": "area_highlight", "value": 1},
      "value": 0.2
    },

    "tooltip": [
      {"field": "Year", "type": "quantitative", "title": "Year", "format": "d"},
      {"field": "LearningArea", "type": "nominal", "title": "Learning area"},
      {"field": "Participation", "type": "quantitative", "title": "Participation (%)", "format": ".1f"}
    ]
  },

  "config": {
    "font": "Arial",
    "view": {"stroke": null}
  }
}